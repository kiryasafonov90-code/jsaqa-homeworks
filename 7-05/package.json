{
  "name": "jsaqa-homework-7-05",
  "version": "1.0.0",
  "private": true,
  "description": "Puppeteer and Cucumber BDD tests for cinema ticket booking",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:bdd": "cucumber-js",
    "test:all": "npm test && npm run test:bdd",
    "test:headed": "cross-env HEADLESS=false npm run test:all",
    "test:bdd:dry-run": "cucumber-js --dry-run --format progress"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "cross-env": "^7.0.3",
    "puppeteer": "^24.10.0"
  }
}
